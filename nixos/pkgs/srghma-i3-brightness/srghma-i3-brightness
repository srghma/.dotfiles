#!/bin/sh -eu

NOTIFY_ID="9912"
TIMEOUT="800"

# get current brightness (float)
cur=$(xbacklight -getf)

# determine step in a single awk call instead of two
step=$(awk -v c="$cur" 'BEGIN {
  if (c <= 1) print 0.1
  else if (c <= 10) print 1
  else print 10
}')

# apply adjustment
case "${1:-}" in
  up)   xbacklight -inc "$step" ;;
  down) xbacklight -dec "$step" ;;
  *)
    echo "usage: $0 {up|down}" >&2
    exit 1
    ;;
esac

# read updated brightness (raw float)
new=$(xbacklight -getf)

# notify user (-r replaces previous notification immediately for responsiveness)
notify-send -r "$NOTIFY_ID" -t "$TIMEOUT" "Brightness: ${new}%"
