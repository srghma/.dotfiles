{
    "[python]": {
        "editor.formatOnType": true
    },
    // "bitoAI.appearance.fontSize (Match with IDE Font)": false,
    // "bitoAI.codeCompletion.enableAutoCompletion": true,
    // "bitoAI.codeCompletion.enableCommentToCode": true,
    "C_Cpp.formatting": "disabled",
    "chat.agent.enabled": false,
    "chat.disableAIFeatures": true,
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    // "codeium.detectProxy": false,
    // "codeium.enableConfig": {
    //     "*": true,
    //     "purescript": true
    // },
    "codetogether.userName": "srghma",
    "continue.enableConsole": true,
    "continue.enableQuickActions": true,
    "continue.enableTabAutocomplete": false,
    "cSpell.userWords": [
        "tinymce"
    ],
    "diffEditor.codeLens": true,
    "diffEditor.ignoreTrimWhitespace": false,
    // "editor.accessibilitySupport": "off",
    // "editor.fontFamily": "FiraCode-VF.ttf",
    "editor.fontFamily": "\"JetBrains Mono\", monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 13,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.inlineSuggest.showToolbar": "always",
    "editor.mouseWheelZoom": true,
    "editor.renderWhitespace": "all",
    "editor.tabCompletion": "on",
    "editor.tabSize": 2,
    "editor.wordWrap": "on",
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "extensions.ignoreRecommendations": true,
    "files.associations": {
        "*.bkp": "latex"
    },
    "files.autoSave": "onFocusChange",
    "files.exclude": {
        "**/__generated__": true,
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.hg": true,
        "**/.next": true,
        "**/.svn": true,
        "**/*.aux": true,
        "**/*.fdb_latexmk": true,
        "**/*.fls": true,
        "**/*.out": true,
        "**/*.pyc": true,
        "**/*.xdv": true,
        "**/CVS": true
    },
    "files.insertFinalNewline": false,
    "files.readonlyInclude": {
        "**/.lake": true,
        "**/.cargo/git/checkouts/**/*.rs": true,
        "**/.cargo/registry/src/**/*.rs": true,
        "**/lib/rustlib/src/rust/library/**/*.rs": true
    },
    "files.simpleDialog.enable": true,
    "files.trimTrailingWhitespace": true,
    // "geminicodeassist.codeGenerationPaneViewEnabled": true,
    // "geminicodeassist.project": "myproject-1704716005885",
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "gitlens.advanced.messages": {
        "suppressCommitHasNoPreviousCommitWarning": false,
        "suppressCommitNotFoundWarning": false,
        "suppressFileNotUnderSourceControlWarning": false,
        "suppressGitVersionWarning": false,
        "suppressLineUncommittedWarning": false,
        "suppressNoRepositoryWarning": false,
        "suppressResultsExplorerNotice": false,
        "suppressShowKeyBindingsNotice": true,
        "suppressUpdateNotice": true,
        "suppressWelcomeNotice": false
    },
    "gitlens.historyExplorer.enabled": true,
    "gitlens.keymap": "alternate",
    "gitlens.views.commitDetails.files.layout": "tree",
    "gitlens.views.fileHistory.enabled": true,
    "gitlens.views.lineHistory.enabled": true,
    "haskell.manageHLS": "PATH",
    // "idris2-lsp.loglevel": "info",
    // "idris2-lsp.path": "/nix/store/gny2kc7s487134y62252fywjb927zinc-idris2-lsp-2024-01-21/bin/idris2-lsp",
    // "idris2-lsp.trace.server": "messages",
    "latex-workshop.view.pdf.viewer": "tab",
    "Lua.codeLens.enable": true,
    "Lua.typeFormat.config": {
        "format_line": "true"
    },
    // "metamath-zero.executablePath": "/home/srghma/projects/mm0/mm0-rs/target/release/mm0-rs",
    // "purescript.buildCommand": "spago build --purs-args --json-error",
