    //     "UserDefinedWarning",
    //     "UnusedDeclaration"
    // ],
    "purescript.trace.server": "verbose",
    "rust-analyzer.showSyntaxTree": true,
    "search.exclude": {
        "**/.direnv": true,
        "**/.lake": true
    },
    "search.followSymlinks": false,
    "search.useGlobalIgnoreFiles": true,
    "search.useParentIgnoreFiles": true,
    "securecoder.enabled": true,
    "security.promptForLocalFileProtocolHandling": false,
    "security.workspace.trust.untrustedFiles": "open",
    // "tabby.api.endpoint": "http://47.103.63.15:50085/",
    // "tabby.codeCompletion": true,
    // "tabby.keybindings": "tabby-style",
