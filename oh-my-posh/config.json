{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "black": "#262B44",
    "blue": "#4B95E9",
    "green": "#59C9A5",
    "orange": "#F07623",
    "red": "#D81E5B",
    "white": "#E0DEF4",
    "yellow": "#F3AE35"
  },
  "secondary_prompt": {
    "template": "<p:yellow,transparent>\ue0b6</><,p:yellow> > </><p:yellow,transparent>\ue0b0</> ",
    "foreground": "p:black",
    "background": "transparent"
  },
  "transient_prompt": {
    "template": "<p:yellow,transparent>\ue0b6</><,p:yellow> {{ .Folder }} </><p:yellow,transparent>\ue0b0</> ",
    "foreground": "p:black",
    "background": "transparent"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "template": " {{ if .SSHSession }}\ueba9 {{ end }}{{ .UserName }} ",
          "foreground": "p:black",
          "background": "p:yellow"
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "template": " \uea83 {{ path .Path .Location }} ",
          "foreground": "p:white",
          "background": "p:orange",
          "options": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "p:black",
          "foreground": "p:white",
          "options": {
            "branch_icon": "\ue0a0 ",
            "branch_identical_icon": "\u2261",
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ if .UpstreamURL }}{{ url .UpstreamIcon .UpstreamURL }} {{ else }}\uf408 {{ end }}<p:white>{{ .HEAD }}</>{{ if .BranchStatus }} <p:blue>{{ .BranchStatus }}</>{{ end }}{{ if .Staging.Changed }} <p:green>\uf046 {{ .Staging.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} <p:white>|</>{{ end }}{{ if .Working.Changed }} <p:red>\uf044 {{ .Working.String }}</>{{ end }}{{ if gt .StashCount 0 }} <p:yellow>\ueb4b {{ .StashCount }}</>{{ end }} "
        },
        {
          "type": "root",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "template": " \uf0e7 ",
          "foreground": "p:white",
          "background": "p:yellow"
        },
        {
          "type": "status",
          "style": "diamond",
          "trailing_diamond": "\ue0b4",
          "template": " {{ if gt .Code 0 }}\uf00d{{ else }}\uf00c{{ end }} ",
          "foreground": "p:white",
          "background": "p:blue",
          "options": {
            "always_enabled": true
          },
          "background_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "node",
          "style": "plain",
          "template": "\ue718 ",
          "foreground": "p:green",
          "background": "transparent",
          "options": {
            "display_mode": "files",
            "fetch_package_manager": false,
            "home_enabled": false
          }
        },
        {
          "type": "go",
          "style": "plain",
          "template": "\ue626 ",
          "foreground": "p:blue",
          "background": "transparent",
          "options": {
            "fetch_version": false
          }
        },
        {
          "type": "python",
          "style": "plain",
          "template": "\ue235 ",
          "foreground": "p:yellow",
          "background": "transparent",
          "options": {
            "display_mode": "files",
            "fetch_version": false,
            "fetch_virtual_env": false
          }
        },
        {
          "type": "shell",
          "style": "plain",
          "template": "in <p:blue><b>{{ .Name }}</b></> ",
          "foreground": "p:white",
          "background": "transparent"
        },
        {
          "type": "time",
          "style": "plain",
          "template": "at <p:blue><b>{{ .CurrentDate | date \"15:04:05\" }}</b></>",
          "foreground": "p:white",
          "background": "transparent"
        }
      ]
    }
  ],
  "tooltips": [
    {
      "type": "aws",
      "style": "diamond",
      "leading_diamond": "\ue0b0",
      "trailing_diamond": "\ue0b4",
      "template": " \ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
      "foreground": "p:white",
      "background": "p:orange",
      "options": {
        "display_default": true
      },
      "tips": [
        "aws"
      ]
    },
    {
      "type": "az",
      "style": "diamond",
      "leading_diamond": "\ue0b0",
      "trailing_diamond": "\ue0b4",
      "template": " \uebd8 {{ .Name }} ",
      "foreground": "p:white",
      "background": "p:blue",
      "options": {
        "display_default": true
      },
      "tips": [
        "az"
      ]
    }
  ],
  "version": 4,
  "final_space": true
}
