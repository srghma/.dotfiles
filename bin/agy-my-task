#!/bin/sh

# Exit immediately if a command exits with a non-zero status
set -e

# --- CONFIGURATION & EMOTICONS ---
# Standard ANSI colors supported natively across modern terminal profiles
COLOR_RESET="\033[0m"
COLOR_BOLD="\033[1m"
COLOR_YELLOW="\033[33m"
COLOR_CYAN="\033[36m"
COLOR_MAGENTA="\033[35m"
COLOR_GREEN="\033[32m"
COLOR_RED="\033[31m"

# Models to rotate through (space-separated string for POSIX loop compatibility)
LIST_OF_MODELS="gemini-3.5-flash claude-4.6-sonnet"

# The engineering instruction layout string
PROMPT_BODY="
/goal

make all tests pass using

CTEST_PARALLEL_LEVEL=\"\$(nproc)\" CTEST_OUTPUT_ON_FAILURE=1 make -C build/release -j \"\$(nproc)\" test ARGS='-E bench/mvcgen/sym'

can first run one by one using  -R \"test1|test2\" parameter

we are trying to port all c++ and h files into rust (only one h file is allowed - lean.h, should be generated by cbindgen)
"

# --- SIGNAL PROTECTION ---
# Capture termination signals cleanly inside the loop
cleanup() {
  printf "\n%b[!] Loop interrupted and terminated by user.%b\n" "$COLOR_RED" "$COLOR_RESET"
  exit 0
}
trap cleanup INT TERM

# --- MAIN AUTOMATION ENGINE ---

main() {
  printf "%b[🚀] Starting automated model execution daemon...%b\n" "$COLOR_BOLD$COLOR_GREEN" "$COLOR_RESET"

  while :; do
    printf "\n%b[⏳] Waiting 1 hour before launching the engineering cycle...%b\n" "$COLOR_YELLOW" "$COLOR_RESET"
    sleep 3600

    # Iterate sequentially over each engineering model configuration
    for model in $LIST_OF_MODELS; do
      printf "\n%b[🤖] Launching execution with architecture: %b%s%b...%b\n" "$COLOR_CYAN" "$COLOR_BOLD" "$model" "$COLOR_RESET" "$COLOR_CYAN"

      # Execute the binary (naturally blocks in /bin/sh until the agent pipeline exits)
      agy --model="$model" -p "$PROMPT_BODY"

      printf "%b[✅] Execution pipeline completed cleanly for %s.%b\n" "$COLOR_GREEN" "$model" "$COLOR_RESET"
    done

    printf "\n%b[🔄] Full multi-model rotation cycle finished. Entering 3-hour cooldown...%b\n" "$COLOR_MAGENTA" "$COLOR_RESET"
    sleep 10800
  done
}

main
