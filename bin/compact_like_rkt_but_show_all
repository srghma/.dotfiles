#!/usr/bin/env python3
import sys
from collections import Counter, defaultdict

# example usage
# git ls-files --others --cached --exclude-standard | compact_like_rkt_but_show_all

def main():
    grouped = defaultdict(list)
    ext_counter = Counter()
    total_files = 0
    total_dirs = set()

    # Read file paths from stdin
    for line in sys.stdin:
        path = line.strip()
        if not path:
            continue

        total_files += 1

        # Separate directory path and filename
        parts = path.rsplit("/", 1)
        if len(parts) == 2:
            d, f = parts[0] + "/", parts[1]
        else:
            d, f = "./", parts[0]

        grouped[d].append(f)

        # Track directory hierarchy for total directory count
        dir_parts = [p for p in d.split("/") if p and p != "."]
        curr = ""
        for p in dir_parts:
            curr += p + "/"
            total_dirs.add(curr)

        # Extract file extension
        if "." in f and not f.startswith("."):
            ext = "." + f.rsplit(".", 1)[-1]
        elif f.startswith(".") and f.count(".") == 1:
            ext = f
        elif "." in f and f.startswith("."):
            ext = "." + f.rsplit(".", 1)[-1]
        else:
            ext = ".none"

        ext_counter[ext] += 1

    # 1. Print all files grouped by directory (no truncation)
    for d, files in grouped.items():
        print(f"{d} {' '.join(files)}")

    # 2. Print summary line (Total Files & Directories)
    num_dirs = len(total_dirs)
    print(f"\n{total_files}F {num_dirs}D:")

    # 3. Print extension counts
    if ext_counter:
        ext_summary = " ".join(
            f"{ext}({count})" for ext, count in ext_counter.most_common()
        )
        print(f"ext: {ext_summary}")


if __name__ == "__main__":
    main()
