#!/usr/bin/env -S bun run
// vim: set filetype=typescript :

import * as fs from "node:fs";
import * as path from "node:path";

// --- Terminal Colors Helper ---
const isColorSupported =
  !("NO_COLOR" in process.env) &&
  process.env.FORCE_COLOR !== "0" &&
  (Boolean(process.stdout.isTTY) || process.env.FORCE_COLOR === "1");

const c = {
  bold: (s: string | number) => (isColorSupported ? `\x1b[1m${s}\x1b[22m` : String(s)),
  dim: (s: string | number) => (isColorSupported ? `\x1b[2m${s}\x1b[22m` : String(s)),
  italic: (s: string | number) => (isColorSupported ? `\x1b[3m${s}\x1b[23m` : String(s)),
  red: (s: string | number) => (isColorSupported ? `\x1b[31m${s}\x1b[39m` : String(s)),
  green: (s: string | number) => (isColorSupported ? `\x1b[32m${s}\x1b[39m` : String(s)),
  yellow: (s: string | number) => (isColorSupported ? `\x1b[33m${s}\x1b[39m` : String(s)),
  blue: (s: string | number) => (isColorSupported ? `\x1b[34m${s}\x1b[39m` : String(s)),
  magenta: (s: string | number) => (isColorSupported ? `\x1b[35m${s}\x1b[39m` : String(s)),
  cyan: (s: string | number) => (isColorSupported ? `\x1b[36m${s}\x1b[39m` : String(s)),
  gray: (s: string | number) => (isColorSupported ? `\x1b[90m${s}\x1b[39m` : String(s)),
  brightYellow: (s: string | number) => (isColorSupported ? `\x1b[93m${s}\x1b[39m` : String(s)),
  brightGreen: (s: string | number) => (isColorSupported ? `\x1b[92m${s}\x1b[39m` : String(s)),
  brightCyan: (s: string | number) => (isColorSupported ? `\x1b[96m${s}\x1b[39m` : String(s)),
};

interface FileBlock {
  relativePath: string;
  content: string;
}

type FileAction = "CREATE" | "UPDATE" | "UNCHANGED";

interface PlannedFile {
  block: FileBlock;
  fullPath: string;
  normalizedNewContent: string;
  action: FileAction;
  sizeBytes: number;
}

function formatBytes(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function cleanToken(raw: string): string {
  return raw.replace(/^[\s`*:#]+/, "").replace(/[\s`*:#]+$/, "");
}

function matchFileBanner(line: string): string | null {
  const match = line.match(/^={3,}\s*FILE:\s*([^\s=]+)/);
  return match ? match[1].trim() : null;
}

function matchHeadingPath(line: string): string | null {
  if (!/^#{1,4}\s+/.test(line)) return null;

  // 1. Check for backticked filename token first
  const backticked = line.match(/`([^`]+)`/);
  if (backticked) {
    const candidate = backticked[1].trim();
    if (/[\.\/]/.test(candidate) && !/\s/.test(candidate)) {
      return candidate;
    }
  }

  // 2. Fallback: heading without backticks, e.g. "### 1. path/to/file.ts"
  const stripped = line.replace(/^#{1,4}\s+(?:\d+[\.\)]\s*)?/, "").trim();
  const firstToken = cleanToken(stripped.split(/\s+/)[0] || "");
  if (/[\.\/]/.test(firstToken) && /[a-zA-Z0-9_\-\[\]]+\.[a-zA-Z0-9_-]+$/.test(firstToken)) {
    return firstToken;
  }

  return null;
}

function extractFilePath(line: string): string | null {
  const trimmed = line.trim();
  const banner = matchFileBanner(trimmed);
  if (banner) return banner;
  return matchHeadingPath(trimmed);
}

function parseMarkdownFiles(rawText: string): FileBlock[] {
  const lines = rawText.replace(/\r\n/g, "\n").split("\n");
  const files: FileBlock[] = [];

  let currentPath: string | null = null;
  let currentLines: string[] = [];
  let inFence = false;

  for (const line of lines) {
    const trimmed = line.trim();

    if (inFence) {
      if (/^```\s*$/.test(trimmed)) {
        if (currentPath) {
          files.push({
            relativePath: currentPath,
            content: currentLines.join("\n"),
          });
        }
        inFence = false;
        currentPath = null;
        currentLines = [];
      } else {
        currentLines.push(line);
      }
    } else {
      if (/^#{1,4}\s+/.test(trimmed) || /^={3,}\s*FILE:/.test(trimmed)) {
        const detected = extractFilePath(line);
        if (detected) {
          currentPath = detected;
          currentLines = [];
        } else {
          currentPath = null;
        }
      } else if (currentPath && /^```/.test(trimmed)) {
        inFence = true;
        currentLines = [];
      }
    }
  }

  return files;
}

function promptUser(message: string): string {
  if (typeof globalThis.prompt === "function") {
    const res = globalThis.prompt(message);
    return res ? res.trim().toLowerCase() : "";
  }

  process.stdout.write(message);
  const buffer = Buffer.alloc(1024);
  try {
    const bytesRead = fs.readSync(0, buffer, 0, 1024, null);
    return buffer.toString("utf-8", 0, bytesRead).trim().toLowerCase();
  } catch {
    return "";
  }
}

function printUsage(): void {
  console.log(`${c.bold("Usage:")} ai-md-extract-and-create-files <markdown-file> [options]

${c.bold("Options:")}
  ${c.cyan("-d, --target-dir <path>")}  Base directory to output files into (default: .)
  ${c.cyan("-f, --force")}              Overwrite existing files without interactive prompt
  ${c.cyan("-n, --dry-run")}            Show the execution plan and exit without writing files
  ${c.cyan("-h, --help")}               Show this help message
`);
}

function main(): void {
  const args = Bun.argv.slice(2);

  if (args.length === 0 || args.includes("-h") || args.includes("--help")) {
    printUsage();
    process.exit(0);
  }

  let markdownFile: string | null = null;
  let targetDir = ".";
  let force = false;
  let dryRun = false;

  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (arg === "-f" || arg === "--force") {
      force = true;
    } else if (arg === "-n" || arg === "--dry-run") {
      dryRun = true;
    } else if (arg === "-d" || arg === "--target-dir") {
      targetDir = args[++i] || ".";
    } else if (arg.startsWith("--target-dir=")) {
      targetDir = arg.split("=")[1] || ".";
    } else if (!arg.startsWith("-") && !markdownFile) {
      markdownFile = arg;
    }
  }

  if (!markdownFile) {
    console.error(c.red("❌ Error: No markdown file specified."));
    printUsage();
    process.exit(1);
  }

  if (!fs.existsSync(markdownFile)) {
    console.error(c.red(`❌ File not found: ${markdownFile}`));
    process.exit(1);
  }

  console.log(c.bold(c.brightCyan("=== 📂 Markdown Code Extractor ===")));
  console.log(`ℹ️  Reading: ${c.cyan(markdownFile)}`);

  const rawContent = fs.readFileSync(markdownFile, "utf-8");
  const blocks = parseMarkdownFiles(rawContent);

  if (blocks.length === 0) {
    console.log(c.yellow(`⚠️  No matching file code blocks found in: ${markdownFile}`));
    process.exit(0);
  }

  // --- Step 1: Compute Execution Plan ---
  const planned: PlannedFile[] = [];

  for (const block of blocks) {
    const fullPath = targetDir === "." ? block.relativePath : path.join(targetDir, block.relativePath);
    const normalizedNewContent = `${block.content.trimEnd()}\n`;
    const exists = fs.existsSync(fullPath);

    let action: FileAction = "CREATE";
    if (exists) {
      const existing = fs.readFileSync(fullPath, "utf-8").replace(/\r\n/g, "\n");
      action = existing === normalizedNewContent ? "UNCHANGED" : "UPDATE";
    }

    planned.push({
      block,
      fullPath,
      normalizedNewContent,
      action,
      sizeBytes: Buffer.byteLength(normalizedNewContent, "utf-8"),
    });
  }

  const createCount = planned.filter((p) => p.action === "CREATE").length;
  const updateCount = planned.filter((p) => p.action === "UPDATE").length;
  const unchangedCount = planned.filter((p) => p.action === "UNCHANGED").length;

  console.log(`\n📋 ${c.bold("Execution Plan")} (${c.cyan(planned.length)} targets):`);
  console.log(
    `   ${c.green(`+ ${createCount} to create`)}, ${c.yellow(`~ ${updateCount} to update`)}, ${c.gray(`= ${unchangedCount} unchanged`)}\n`
  );

  for (const item of planned) {
    const sizeStr = c.dim(`(${formatBytes(item.sizeBytes)})`);
    if (item.action === "CREATE") {
      console.log(`  ${c.brightGreen("➕ [CREATE]")}    ${item.fullPath} ${sizeStr}`);
    } else if (item.action === "UPDATE") {
      console.log(`  ${c.brightYellow("🔄 [UPDATE]")}    ${item.fullPath} ${sizeStr}`);
    } else {
      console.log(`  ${c.gray("⏭️  [UNCHANGED]")} ${item.fullPath} ${sizeStr}`);
    }
  }

  if (dryRun) {
    console.log(c.dim("\n--dry-run specified: No files were modified."));
    process.exit(0);
  }

  console.log(`\n${c.bold("🚀 Applying changes:")}\n`);

  // --- Step 2: Apply Actions ---
  let writtenCount = 0;
  let skippedCount = 0;
  let forceAll = force;

  for (const item of planned) {
    if (item.action === "UNCHANGED") {
      console.log(`  ${c.gray("⏭ Unchanged:")} ${item.fullPath}`);
      continue;
    }

    if (item.action === "UPDATE" && !forceAll) {
      const choice = promptUser(
        `  ⚠️  File '${c.yellow(item.fullPath)}' differs. Overwrite? [y/N/a/q]: `
      );

      if (choice === "a" || choice === "all") {
        forceAll = true;
      } else if (choice === "y" || choice === "yes") {
        // proceed
      } else if (choice === "q" || choice === "quit") {
        console.log(c.yellow("⚠️  Aborted by user."));
        break;
      } else {
        console.log(`  ${c.gray("⏭ Skipped:")} ${item.fullPath}`);
        skippedCount++;
        continue;
      }
    }

    // Ensure parent directory exists
    const parentDir = path.dirname(item.fullPath);
    if (parentDir && !fs.existsSync(parentDir)) {
      fs.mkdirSync(parentDir, { recursive: true });
    }

    fs.writeFileSync(item.fullPath, item.normalizedNewContent, "utf-8");

    if (item.action === "CREATE") {
      console.log(`  ${c.green("✔ Created:")} ${item.fullPath}`);
    } else {
      console.log(`  ${c.yellow("✔ Updated:")} ${item.fullPath}`);
    }
    writtenCount++;
  }

  // --- Summary ---
  console.log(`\n${c.dim("========================================")}`);
  console.log(c.bold(c.brightGreen("🎉 Finished processing!")));
  console.log(`   Created/Updated: ${c.bold(c.green(writtenCount))}`);
  console.log(`   Unchanged:       ${c.bold(c.gray(unchangedCount))}`);
  console.log(`   Skipped:         ${c.bold(c.yellow(skippedCount))}`);
  console.log(c.dim("========================================"));
}

main();
